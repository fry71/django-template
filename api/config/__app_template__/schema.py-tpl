from __future__ import annotations

from ninja import Schema
from pydantic import Field


def _meta(description: str) -> dict[str, str]:
    """Field metadata for JSON Schema via pydantic v2."""
    return {"metadata": {"description": description}}


class {{ camel_case_app_name }}Out(Schema):
    id: int = Field(**_meta("Record ID"))
    message: str = Field(**_meta("Message"))
